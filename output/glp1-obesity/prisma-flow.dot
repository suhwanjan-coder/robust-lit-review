digraph PRISMA {
  rankdir=TB;
  graph [fontname="Noto Serif CJK TC", fontsize=13, nodesep=0.55, ranksep=0.65, bgcolor="white"];
  node  [fontname="Noto Serif CJK TC", fontsize=11, shape=box, style="filled,rounded",
         fillcolor="#eaf2fb", color="#34699c", penwidth=1.3, margin="0.20,0.14"];
  edge  [color="#34699c", penwidth=1.2, arrowsize=0.85];

  // 主流程（左欄）
  id       [label="識別\n透過 PubMed 檢索之紀錄\n(n = 674)\nRCT 275　・　SR/MA 399"];
  screen   [label="去重後標題／摘要篩選\n(n = 643)"];
  fulltext [label="全文評估合格性\n(n = 103)"];
  included [label="納入本回顧之研究\n(n = 20)", fillcolor="#d8ecd8", color="#2e7d32", penwidth=1.6];

  // 排除（右欄）
  exdup [label="篩選前移除\n重複紀錄 (n = 31)",
         fillcolor="#fdeaea", color="#b03a3a"];
  exscr [label="篩選排除 (n = 540)\n主題不符／族群不符／非英文",
         fillcolor="#fdeaea", color="#b03a3a"];
  exful [label="全文排除 (n = 83)\n非 Q1 期刊 58　・　DOI 未驗證 5　・　結局不符 20",
         fillcolor="#fdeaea", color="#b03a3a"];

  id -> screen -> fulltext -> included;

  { rank=same; id;       exdup; }  id       -> exdup [constraint=false];
  { rank=same; screen;   exscr; }  screen   -> exscr [constraint=false];
  { rank=same; fulltext; exful; }  fulltext -> exful [constraint=false];
}
